# ===============================================
# BACKEND - Variáveis de Ambiente
# ===============================================
# Copie este arquivo para .env e preencha os valores

# Azure Entra ID (Microsoft Entra ID / Azure AD)
TENANT_ID=seu-tenant-id-aqui
CLIENT_ID=seu-client-id-aqui
ALLOWED_DOMAIN=creditsbrasil.com.br

# Callbacks Ploomes (URLs seguras - NUNCA exponha ao frontend)
PLOOMES_CALLBACK_1=https://pbi.ploomes.com/powerbi/callback/...
PLOOMES_CALLBACK_2=https://pbi.ploomes.com/powerbi/callback/...

# Cache
CACHE_TTL_SECONDS=600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# HTTP Client
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# CORS - URL do Frontend
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO
